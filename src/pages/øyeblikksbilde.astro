---
    import Layout from '../layouts/Layout.astro';
---
<Layout>
    <main>
        <h1>Øyeblikksbilde</h1>
        <section class="about-section">
                    <div class="container">
                        <div class="about-content">
                            <div class="about-column">
                                <img src="/gruppeside/icons/book-open.svg"/>
                                <h3>Hva er det vi skal utvikle / lage</h3>
                                <p>
                                    Vi skal videutvikle et system fra Sikri. Elements er et system som gir innsikt i demokratiske 
                                </p>
                            </div>
                            <div class="about-column">
                                <img src="/gruppeside/icons/book-open.svg"/>
                                <h3>Hva er viktige kvalitetsaspekter i vårt produkt?</h3>
                                <p>
                                    Funksjonalitet, design og sikkerhet
                                </p>
                            </div>
                            <div class="about-column">
                                <img src="/gruppeside/icons/book-open.svg"/>
                                <h3>Hvordan vite hvordan grad ønsket kvalitet er oppnådd?</h3>
                                <ul class="text-center">
                                    <li>Spørre brukergruppen</li>
                                    <li>Kommunikasjon med Sikri om mangler</li>
                                    <li>Måle etter features</li>
                                    <li>Oppnå mål i sprints</li>
                                    <li>Brukertester gjennom perioden</li>
                                    <li>Iterere</li>
                                    <li>Måle kvalitetaspekter innad i gruppen (code reviews)</li>
                                </ul>
                            </div>
                            <div class="about-column">
                                <img src="/gruppeside/icons/book-open.svg"/>
                                <h3>Oppstart?</h3>
                                <ul class="text-start">
                                    <li>Backlog</li>
                                    <li>Estimater</li>
                                    <li>Ressursbruk</li>
                                    <li>Overvåke sprints</li>
                                </ul>
                            </div>
                            <div class="about-column">
                                <img src="/gruppeside/icons/book-open.svg"/>
                                <h3>Kvalitetsikre Backlog?</h3>
                                <ul class="text-start">
                                    <li>Estimere tid</li>
                                    <li>Research</li>
                                </ul>
                            </div>
                            <div class="about-column">
                                <img src="/gruppeside/icons/book-open.svg"/>
                                <h3>Hvordan bruker vi time estimering og estimater til kontroll?</h3>
                                <ul class="text-start">
                                    <li>Timerapportering</li>
                                    <li></li>MOSCOW</li>
                                </ul>
                            </div>
                        </div>
                    </div>
        </section>
    </main>
</Layout>